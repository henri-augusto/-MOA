# Mesmo usuário configurado no segredo DOCKERHUB_USERNAME do GitHub.
DOCKERHUB_USERNAME=seu-usuario
IMAGE_TAG=latest
# Porta publicada no VPS.
HOST_PORT=3000

# Supabase (Project Settings > API). Para desenvolvimento, copie para .env.local.
# No build da imagem, as duas entram como build args (segredos de mesmo nome no GitHub).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
