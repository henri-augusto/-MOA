# Mesmo usuário configurado no segredo DOCKERHUB_USERNAME do GitHub.
DOCKERHUB_USERNAME=seu-usuario
IMAGE_TAG=latest
# Porta publicada no VPS.
HOST_PORT=3000

# URL pública do site (sem barra no final). Usada nos links de confirmação de e-mail,
# no callback do Supabase, na volta do checkout e no retorno do cadastro Stripe.
# Em produção é obrigatória. No Dashboard do Supabase, inclua {SITE_URL}/auth/callback
# na allowlist de Redirect URLs.
# Em desenvolvimento local, se omitir, só localhost / 127.0.0.1 são aceitos.
SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Para desenvolvimento, copie para .env.local.
# No build da imagem, as duas entram como build args (segredos de mesmo nome no GitHub).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
# Só no servidor: checkout, webhook e download do pedido.
# Project Settings > API Keys > Secret key (sb_secret_...). Sem ela o checkout falha.
# O docker-compose.yml repassa esta chave e as do Stripe ao container. Elas não entram na imagem.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sua-chave

# Stripe Connect (Dashboard > Developers > API keys e Webhooks).
# STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET ficam só no container.
# A chave pública entra no build da imagem (segredo NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY no GitHub).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
